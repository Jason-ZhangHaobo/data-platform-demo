V2_HOST=127.0.0.1
V2_PORT=3100
# Local-only development session. Never enable for public hosting.
V2_LOCAL_DEVELOPMENT=true
V2_META_DRIVER=sqlite
# Use a separate metadata database for cloud deployment.
# V2_MYSQL_URL=mysql://platform_user:password@host/platform_meta
DASHSCOPE_API_KEY=
V2_MODEL=qwen3-coder-plus
V2_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
V2_MODEL_TOKEN_BUDGET=32000
V2_MODEL_OUTPUT_LIMIT=6000
V2_RUN_TIMEOUT_MS=90000
# Runtime paths are auto-detected under .runtime when installed.
# JAVA_HOME=/absolute/path/to/jdk
# V2_PYTHON=/absolute/path/to/python
