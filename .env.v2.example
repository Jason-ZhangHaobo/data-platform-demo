V2_HOST=127.0.0.1
V2_PORT=3100
# Local-only development session. Never enable for public hosting.
V2_LOCAL_DEVELOPMENT=true
V2_META_DRIVER=sqlite
# Use a separate metadata database for cloud deployment.
# V2_MYSQL_HOST=rm-example.mysql.rds.aliyuncs.com
# V2_MYSQL_PORT=3306
# V2_MYSQL_USER=platform_app
# V2_MYSQL_PASSWORD=
# V2_MYSQL_DATABASE=platform_meta
# V2_MYSQL_POOL_SIZE=2
# V2_MYSQL_CONNECT_TIMEOUT_MS=5000
# V2_MYSQL_SSL=false
# Private OSS state is used only by src/v2/cloud-server.mjs.
# OSS_BUCKET=private-bucket-name
# OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
# V2_OSS_STATE_OBJECT_KEY=data-platform-v2/state/project-securities-lab.json
# V2_OSS_STATE_MAX_BYTES=41943040
# V2_OSS_ARTIFACT_PREFIX=data-platform-v2/artifacts
# Public mode additionally requires an exact HTTPS origin and bootstrap admin
# credentials supplied by the cloud secret store, never committed here.
# V2_PUBLIC_ORIGIN=https://your-filed-domain.example
# V2_BOOTSTRAP_ADMIN_EMAIL=
# V2_BOOTSTRAP_ADMIN_PASSWORD=
# V2_BOOTSTRAP_ADMIN_NAME=
# Optional isolated Spark worker. Keep unset to fail closed in public mode.
# V2_SPARK_EXECUTOR_URL=https://dedicated-worker.example
# V2_SPARK_EXECUTOR_SECRET=
# V2_SPARK_EXECUTOR_TIMEOUT_MS=120000
DASHSCOPE_API_KEY=
V2_MODEL=qwen3-coder-plus
V2_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
V2_MODEL_TOKEN_BUDGET=32000
V2_MODEL_OUTPUT_LIMIT=6000
V2_RUN_TIMEOUT_MS=90000
# Runtime paths are auto-detected under .runtime when installed.
# JAVA_HOME=/absolute/path/to/jdk
# V2_PYTHON=/absolute/path/to/python
