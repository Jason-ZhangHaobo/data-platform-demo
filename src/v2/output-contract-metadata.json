          ]
        },
        {
          "field": "holding_market_value",
          "label": "持仓市值（元）",
          "sourceFields": [
            "positions.position_id",
            "positions.market_value"
          ]
        },
        {
          "field": "security_count",
          "label": "证券数量（按代码去重）",
          "sourceFields": [
            "positions.security_code"
          ]
        },
        {
          "field": "market_value_ratio",
          "label": "持仓市值占比（0—1，不含现金）",
          "sourceFields": [
            "positions.market_value",
            "positions.asset_class"
          ]
        }
      ],
      "constraints": [
        "SCOPED_CLIENTS",
